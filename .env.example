# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 넣으세요 (.env는 깃에 올라가지 않아요)

# 어떤 AI를 쓸지: claude (Claude API, 유료) | ollama (내 PC 모델, 무료)
LLM=claude

# --- LLM=claude 일 때 ---
ANTHROPIC_API_KEY=sk-ant-여기에-키
# 기본은 claude-haiku-5-5 (저렴). 설명 품질을 더 높이려면 claude-opus-5-5
CLAUDE_MODEL=claude-haiku-5-5

# --- LLM=ollama 일 때 ---  (먼저: ollama create sogaeting-ai -f Modelfile)
OLLAMA_MODEL=sogaeting-ai
OLLAMA_URL=http://127.0.0.1:11434
